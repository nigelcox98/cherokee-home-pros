---
import Layout from '../../layouts/Layout.astro';
import ProCard from '../../components/ProCard.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { cities, cityMeta } from '../../data/cities';

export const getStaticPaths = (async () => {
  return cities.map((city) => ({
    params: { slug: city.slug },
  }));
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const meta = cityMeta[slug!] ?? { title: slug, blurb: '' };

const allPros = await getCollection('pros');
const matching = allPros
  .filter((p) => {
    const citySlug = p.data.city.toLowerCase().replace(/\s+/g, '-');
    const serves = p.data.cities.map((c) => c.toLowerCase().replace(/\s+/g, '-'));
    return citySlug === slug || serves.includes(slug!);
  })
  .sort((a, b) => {
    if (a.data.featured && !b.data.featured) return -1;
    if (!a.data.featured && b.data.featured) return 1;
    return a.data.name.localeCompare(b.data.name);
  });
---

<Layout title={`${meta.title} home services — Cherokee Home Pros`}>
  <section class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900">Home services in {meta.title}</h1>
    <p class="mt-3 max-w-2xl text-slate-600">{meta.blurb}</p>
    <div class="mt-5">
      <a
        href={`/get-quote?city=${slug}`}
        class="inline-flex items-center rounded-lg bg-sky-600 px-5 py-2.5 font-medium text-white hover:bg-sky-500"
      >
        Get quotes in this city →
      </a>
    </div>
  </section>

  <section>
    <h2 class="mb-4 text-lg font-semibold text-slate-900">
      {matching.length} pro{matching.length === 1 ? '' : 's'} listed
    </h2>
    {matching.length === 0 ? (
      <p class="text-slate-600">No listings yet for this city. Request a quote and we will match nearby pros.</p>
    ) : (
      <div class="grid gap-4 sm:grid-cols-2">
        {matching.map((pro) => (
          <ProCard pro={pro} />
        ))}
      </div>
    )}
  </section>
</Layout>
