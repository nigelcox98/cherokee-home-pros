---
import Layout from '../layouts/Layout.astro';
import ProCard from '../components/ProCard.astro';
import { getCollection } from 'astro:content';
import { cities } from '../data/cities';
import { services } from '../data/services';

const allPros = await getCollection('pros');
const featured = allPros.filter((p) => p.data.featured);
const homeCities = cities.filter((city) => city.slug !== 'marietta');
---

<Layout>
  <section class="mb-12">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
      Local home services in Cherokee County
    </h1>
    <p class="mt-3 max-w-2xl text-lg text-slate-600">
      Septic, pool, roofing, HVAC, plumbing and EV pros who actually work Canton,
      Woodstock, Holly Springs and nearby cities. Request quotes from a few at once.
    </p>
    <div class="mt-6">
      <a
        href="/get-quote"
        class="inline-flex items-center rounded-lg bg-sky-600 px-5 py-2.5 font-medium text-white hover:bg-sky-500"
      >
        Get free quotes →
      </a>
    </div>
  </section>

  <section class="mb-10">
    <h2 class="mb-3 text-sm font-medium uppercase tracking-wider text-slate-500">By service</h2>
    <div class="flex flex-wrap gap-2">
      {services.map((s) => (
        <a
          href={`/services/${s.slug}`}
          class="rounded-full border border-slate-300 bg-white px-4 py-1.5 text-sm text-slate-700 hover:border-slate-400 hover:bg-slate-50"
        >
          {s.label}
        </a>
      ))}
    </div>
  </section>

  <section class="mb-12">
    <h2 class="mb-3 text-sm font-medium uppercase tracking-wider text-slate-500">By city</h2>
    <div class="flex flex-wrap gap-2">
      {homeCities.map((c) => (
        <a
          href={`/cities/${c.slug}`}
          class="rounded-full border border-slate-300 bg-white px-4 py-1.5 text-sm text-slate-700 hover:border-slate-400 hover:bg-slate-50"
        >
          {c.label}
        </a>
      ))}
    </div>
  </section>

  {featured.length > 0 && (
    <section class="mb-12">
      <h2 class="mb-5 text-xl font-semibold text-slate-900">Featured pros</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {featured.map((pro) => (
          <ProCard pro={pro} />
        ))}
      </div>
    </section>
  )}

  <section>
    <div class="mb-5 flex items-center justify-between">
      <h2 class="text-xl font-semibold text-slate-900">Recent listings</h2>
      <a href="/pros" class="text-sm text-sky-700 hover:text-sky-900">View all →</a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {allPros.slice(0, 6).map((pro) => (
        <ProCard pro={pro} />
      ))}
    </div>
  </section>
</Layout>
