---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Request received — Cherokee Home Pros">
  <section class="mx-auto max-w-xl text-center">
    <h1 class="text-3xl font-bold text-slate-900">We got your request</h1>
    <p class="mt-4 text-lg text-slate-600">
      Matching local pros will reach out directly. There is no charge to you for this request.
    </p>
    <p class="mt-3 text-slate-600">
      If you do not hear back, call a listed pro from the directory or submit again with more detail.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href="/"
        class="inline-flex items-center rounded-lg bg-sky-600 px-5 py-2.5 font-medium text-white hover:bg-sky-500"
      >
        Back to home
      </a>
      <a
        href="/pros"
        class="inline-flex items-center rounded-lg border border-slate-300 bg-white px-5 py-2.5 font-medium text-slate-800 hover:bg-slate-50"
      >
        Browse pros
      </a>
    </div>
  </section>
</Layout>
