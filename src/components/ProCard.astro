---
import type { CollectionEntry } from 'astro:content';

interface Props {
  pro: CollectionEntry<'pros'>;
}

const { pro } = Astro.props;
const { name, city, categories, phone, notes, emergency, featured } = pro.data;

const categoryLabels: Record<string, string> = {
  septic: 'Septic',
  plumbing: 'Plumbing',
  pool: 'Pool',
  roofing: 'Roofing',
  hvac: 'HVAC',
  electrical: 'Electrical',
  'ev-charger': 'EV Charger',
  'tesla-body': 'Tesla Body',
};
---

<a
  href={`/pros/${pro.id}`}
  class="block rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-slate-300 hover:shadow"
>
  <div class="mb-2 flex flex-wrap items-center gap-2">
    {featured && (
      <span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-800">
        Featured
      </span>
    )}
    {emergency && (
      <span class="rounded-full bg-rose-100 px-2.5 py-0.5 text-xs font-medium text-rose-800">
        24/7
      </span>
    )}
  </div>

  <h2 class="text-lg font-semibold text-slate-900">{name}</h2>
  <p class="mt-1 text-sm text-slate-500">{city}</p>
  {phone && <p class="mt-1 text-sm font-medium text-slate-700">{phone}</p>}
  <p class="mt-3 text-sm leading-relaxed text-slate-600">{notes}</p>

  <div class="mt-4 flex flex-wrap gap-1.5">
    {categories.map((cat) => (
      <span class="rounded bg-slate-100 px-2 py-0.5 text-xs text-slate-600">
        {categoryLabels[cat] || cat}
      </span>
    ))}
  </div>
</a>
