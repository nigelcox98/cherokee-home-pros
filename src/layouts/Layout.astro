---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Cherokee Home Pros',
  description = 'Local septic, pool, roofing, HVAC, plumbing and EV services in Canton, Woodstock, Holly Springs and nearby North Atlanta cities.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-5xl flex-col gap-3 px-4 py-4 sm:flex-row sm:items-center sm:justify-between">
        <a href="/" class="text-lg font-semibold tracking-tight text-slate-900">
          Cherokee Home Pros
        </a>
        <nav class="flex flex-wrap gap-4 text-sm text-slate-600 sm:gap-5">
          <a href="/pros" class="hover:text-slate-900">Pros</a>
          <a href="/get-quote" class="font-medium text-sky-700 hover:text-sky-900">Get a quote</a>
          <a href="/about" class="hover:text-slate-900">About</a>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-4 py-10">
      <slot />
    </main>

    <footer class="border-t border-slate-200 bg-white py-8 text-center text-sm text-slate-500">
      <p>
        Independent local directory for Cherokee County and nearby North Atlanta cities.
        Not affiliated with any listed company.
      </p>
      <p class="mt-2">
        <a href="/get-quote" class="text-sky-700 underline hover:text-sky-900">Request quotes</a>
        {' · '}
        <a href="/about" class="underline hover:text-slate-700">About</a>
      </p>
    </footer>
  </body>
</html>
